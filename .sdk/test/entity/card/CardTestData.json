                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "password": {
                      "description": "8-digit card password/ID",
                      "example": "00010000",
                      "type": "string"
                    },
                    "rank": {
                      "description": "Rank of XYZ monster",
                      "type": "integer"
                    },
                    "text": {
