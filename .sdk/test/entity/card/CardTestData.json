                        "DARK",
                        "LIGHT",
                        "EARTH",
                        "WATER",
                        "FIRE",
                        "WIND",
                        "DIVINE"
                      ],
                      "type": "string"
                    },
                    "cardType": {
                      "description": "Type of card (Monster, Spell, Trap, etc.)",
                      "enum": [
                        "Monster",
                        "Spell",
                        "Trap"
                      ],
                      "type": "string"
                    },
                    "def": {
                      "description": "Defense points",
                      "nullable": true,
                      "type": "integer"
                    },
