    "GET /data/tcg-speed-skill/{yugipediaId}.json": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "getSpeedDuelSkillCardById",
        "parameters": [
          {
            "description": "Yugipedia page ID for the Speed Duel Skill Card (e.g., 'yugipedia585581')",
            "example": "yugipedia585581",
            "in": "path",
            "name": "yugipediaId",
            "required": true,
