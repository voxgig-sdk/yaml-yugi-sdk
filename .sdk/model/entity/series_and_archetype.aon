# Entity: series_and_archetype

main: kit: entity: series_and_archetype: {

  alias: field: {}

  fields: [
    {
      name: "cards"
      req: false
      short: "List of card IDs belonging to this series/archetype"
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: false
      short: "Series/archetype name in multiple languages"
      type: "`$OBJECT`"
    }
  ]

  name: "series_and_archetype"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/data/series/list.yaml"
          segments: [
            {
              lit: "data"
            }
            {
              lit: "series"
            }
            {
              lit: "list.yaml"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/data/series/map.json"
          segments: [
            {
              lit: "data"
            }
            {
              lit: "series"
            }
            {
              lit: "map.json"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/data/series/map.yaml"
          segments: [
            {
              lit: "data"
            }
            {
              lit: "series"
            }
            {
              lit: "map.yaml"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
