# Entity: skill_card

main: kit: entity: skill_card: {

  alias: field: {}

  fields: [
    {
      name: "cardType"
      req: false
      short: "Type identifier for skill cards"
      type: "`$STRING`"
    }
    {
      name: "character"
      req: false
      short: "Character associated with the skill"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Skill card name in multiple languages"
      type: "`$OBJECT`"
    }
    {
      name: "text"
      req: false
      short: "Skill card text in multiple languages"
      type: "`$OBJECT`"
    }
    {
      name: "yugipediaId"
      req: false
      short: "Yugipedia page ID"
      type: "`$STRING`"
    }
  ]

  name: "skill_card"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "yugipedia585581"
                kind: "param"
                name: "yugipedia_id"
                orig: "yugipedia_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/data/tcg-speed-skill/{yugipediaId}.json"
          segments: [
            {
              lit: "data"
            }
            {
              lit: "tcg-speed-skill"
            }
            {
              lit: "{yugipediaId}.json"
            }
          ]
          select: {
            exist: [
              "yugipedia_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
